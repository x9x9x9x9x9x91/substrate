[Unit]
Description=Substrate hosted-sync blob store (single tenant)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=20

[Service]
Type=simple
User=substrate-blob
Group=substrate-blob
WorkingDirectory=/var/lib/substrate-blob
EnvironmentFile=/etc/substrate-blob.env
ExecStart=/opt/substrate-blob/current
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/substrate-blob
CapabilityBoundingSet=
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=96

[Install]
WantedBy=multi-user.target

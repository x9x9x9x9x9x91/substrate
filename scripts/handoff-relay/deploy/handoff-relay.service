[Unit]
Description=Substrate encrypted handoff relay
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=20

[Service]
Type=simple
User=substrate-handoff
Group=substrate-handoff
WorkingDirectory=/var/lib/substrate-handoff
ExecStart=/usr/bin/node /opt/substrate-handoff/current.mjs
Environment=PORT=8787
Environment=BIND=127.0.0.1
Environment=HANDOFF_DIR=/var/lib/substrate-handoff
Environment=HANDOFF_MAX_BYTES=33554432
Environment=HANDOFF_MAX_TOTAL=1073741824
Environment=HANDOFF_MAX_ENTRIES=4096
Environment=HANDOFF_MAX_CONCURRENT_STORES=2
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/substrate-handoff
CapabilityBoundingSet=
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target

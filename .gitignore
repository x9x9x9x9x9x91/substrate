# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-release/
dist-ssr
*.local
/src-tauri/binaries/substrate-mcp-*
# Staged copies of cookbook/ and examples/vault/ for the bundler to package.
# Written fresh before every build, so a committed one would only ever be a
# stale tree shipped inside a release.
/src-tauri/gen/bundle-resources/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.worktrees/
.claude/*
!.claude/skills/
!.claude/settings.json

# Playwright
/test-results/
/playwright-report/
# evidence-only shots (SHOTS=1 specs), never product
/shots/

# TS incremental build state
*.tsbuildinfo

# npm ci freshness marker written by scripts/rig-gates-runner.sh — a local
# build artifact, and an untracked one would make the tree unreleasable
.npm-ci-stamp

# Local Cargo config is intentionally untracked. Checked-in absolute paths
# made every clone fail after the primary-machine cutover.
.cargo/config.toml

# Meaning search fetches its ONNX Runtime here (scripts/fetch-onnxruntime.sh):
# a pinned 38 MB native library, not source.
/src-tauri/vendor/onnxruntime/

# Coverage reports (scripts/coverage-report.ts). Report-only output, regenerated
# by `npm run coverage` and published by the nightly pass — never committed.
/coverage/

# Evidence bundles from the auto-sync verification lane
# (scripts/autosync-verify.sh): a dated capture + transcript per run, kept on
# purpose so a release can point at one. Machine-local proof, never source.
/.autosync-evidence/

# Probe fixtures a test plants in the tracked tree and removes again
# (scripts/live-tree.ts PROBE_SUFFIX). Transient by construction — a committed
# one would only ever be the leftover of a run that died mid-test.
*.probe.tsx
